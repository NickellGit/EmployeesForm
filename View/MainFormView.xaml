<Window x:Class="EmployeesForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeesForm"
        xmlns:VM="clr-namespace:EmployeesForm.ViewModel"
        mc:Ignorable="d"
        Title="Форма для таблицы Employees" 
        Height="800" 
        Width="1400">

    <Window.DataContext>
        <VM:MainViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Background="White" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding SecondName}"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}"/>
                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}"/>
                <DataGridTextColumn Header="Дата найма" Binding="{Binding HireDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridCheckBoxColumn Header="Удалёнка" Binding="{Binding IsRemote}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Padding="15">
            <StackPanel >
                <TextBlock Text="{Binding EditebleEmployee.SecondName, StringFormat='Редактируемая запись: {0}'}"/>
                <TextBlock Text="Имя:"/>
                <TextBox Text="{Binding EditebleEmployee.FirstName}" MaxLength="50"/>
                <TextBlock Text="Фамилия:"/>
                <TextBox Text="{Binding EditebleEmployee.SecondName}" MaxLength="50"/>
                <TextBlock Text="Должность:"/>
                <TextBox Text="{Binding EditebleEmployee.Position}" MaxLength="50"/>
                <TextBlock Text="Заплата:"/>
                <TextBox Text="{Binding EditebleEmployee.Salary, UpdateSourceTrigger=PropertyChanged}" MaxLines="12"/>
                <TextBlock Text="Дата найма:"/>
                <DatePicker SelectedDate="{Binding EditebleEmployee.HireDate}"/>
                <CheckBox IsChecked="{Binding EditebleEmployee.IsRemote}" Content="Удалёнка?" VerticalContentAlignment="Center"/>

                <Button Command="{Binding Save}" Content="Сохранить" Background="PaleGreen" Margin="0 20 0 0"/>
                <Button Command="{Binding Delete}" Content="Удалить" Background="Salmon" Margin="0 20 0 0"/>
                <Button Command="{Binding Clear}" Content="Сбросить/отчистить" Background="LightGray" Margin="0 20 0 0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
